{{ $games := where .Site.RegularPages "Section" "games" }}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ .Site.Title }}</title>
    <meta name="description" content="{{ .Site.Params.Description | default .Site.Title }}" />
    <style>
      :root {
        --bg: #0b0f14;
        --panel: #121a22;
        --panel-alt: #1b2731;
        --text: #edf3f7;
        --muted: #a5b7c4;
        --line: rgba(255,255,255,0.08);
        --brand: #59d0b7;
        --brand-2: #7fb7ff;
        --accent: #f6c453;
        --shadow: 0 24px 80px rgba(0, 0, 0, 0.32);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Inter, "Segoe UI", sans-serif;
        background: radial-gradient(circle at top, #111c26 0%, var(--bg) 55%);
        color: var(--text);
        line-height: 1.6;
      }

      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; }

      .container {
        width: min(1100px, calc(100% - 2rem));
        margin: 0 auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(12px);
        background: rgba(9, 13, 17, 0.7);
        border-bottom: 1px solid var(--line);
      }

      .site-header .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 74px;
      }

      .brand {
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--text);
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 1rem;
        color: var(--muted);
      }

      .nav a {
        padding: 0.45rem 0.8rem;
        border-radius: 999px;
        transition: all 0.2s ease;
      }

      .nav a:hover {
        background: rgba(255,255,255,0.04);
        color: var(--text);
      }

      .wr-page {
        padding-bottom: 4rem;
      }

      .hero {
        padding: 5rem 0 3rem;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 2rem;
        align-items: center;
      }

      .eyebrow {
        margin: 0 0 1rem;
        color: var(--brand);
        font-size: 0.8rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 700;
      }

      h1 {
        font-size: clamp(2.8rem, 5vw, 5rem);
        line-height: 1.05;
        margin: 0 0 1rem;
      }

      .hero-copy p {
        margin: 0;
        max-width: 620px;
        font-size: 1.08rem;
        color: var(--muted);
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 2rem;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.95rem 1.4rem;
        border-radius: 999px;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .button:hover {
        transform: translateY(-1px);
      }

      .button.primary {
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        color: #04130f;
        box-shadow: 0 14px 36px rgba(89, 208, 183, 0.3);
      }

      .button.secondary {
        border: 1px solid var(--line);
        color: var(--text);
        background: rgba(255,255,255,0.02);
      }

      .hero-card {
        padding: 1.5rem;
        background: linear-gradient(180deg, rgba(27,39,49,0.96), rgba(18,26,34,0.96));
        border: 1px solid var(--line);
        border-radius: 24px;
        box-shadow: var(--shadow);
      }

      .mini-panel {
        display: grid;
        gap: 1rem;
      }

      .mini-panel div {
        padding: 1rem 1.1rem;
        border-radius: 16px;
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--line);
      }

      .mini-panel strong {
        display: block;
        font-size: 1.4rem;
        margin-bottom: 0.2rem;
      }

      .mini-panel span {
        color: var(--muted);
      }

      .reviews,
      .support {
        padding-top: 2rem;
      }

      .section-header {
        display: flex;
        justify-content: space-between;
        align-items: end;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      h2 {
        margin: 0;
        font-size: clamp(1.9rem, 2vw, 2.6rem);
      }

      .search-wrap {
        display: inline-flex;
        flex-direction: column;
        gap: 0.5rem;
        color: var(--muted);
        font-size: 0.85rem;
      }

      .search-wrap input {
        width: min(320px, 80vw);
        padding: 0.9rem 1rem;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: rgba(255,255,255,0.02);
        color: var(--text);
        font: inherit;
      }

      .game-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.25rem;
      }

      .game-card {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        padding: 1.3rem;
        border-radius: 22px;
        border: 1px solid var(--line);
        background: linear-gradient(180deg, rgba(17,26,32,0.92), rgba(13,18,23,0.9));
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.15);
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .game-card:hover {
        transform: translateY(-2px);
        border-color: rgba(89, 208, 183, 0.5);
      }

      .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .tag {
        display: inline-flex;
        align-items: center;
        padding: 0.38rem 0.7rem;
        border-radius: 999px;
        background: rgba(89, 208, 183, 0.12);
        border: 1px solid rgba(89,208,183,0.3);
        color: var(--brand);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .favorite-btn {
        border: 1px solid var(--line);
        background: transparent;
        color: var(--muted);
        border-radius: 10px;
        width: 38px;
        height: 38px;
        font-size: 1.2rem;
        cursor: pointer;
      }

      .favorite-btn.is-favorite {
        background: rgba(246,196,83,0.12);
        color: var(--accent);
        border-color: rgba(246,196,83,0.4);
      }

      .game-card h3 {
        margin: 0;
        font-size: 1.45rem;
      }

      .game-card p {
        margin: 0;
        color: var(--muted);
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .meta span {
        display: inline-flex;
        padding: 0.35rem 0.6rem;
        border-radius: 999px;
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.72rem;
      }

      .read-more {
        margin-top: auto;
        color: var(--brand);
        font-weight: 700;
      }

      .support-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        padding: 2rem;
        border: 1px solid var(--line);
        border-radius: 24px;
        background: linear-gradient(180deg, rgba(17,22,32,0.9), rgba(14,20,26,0.9));
      }

      .support-box p {
        margin: 0.5rem 0 0;
        color: var(--muted);
      }

      @media (max-width: 820px) {
        .hero-grid {
          grid-template-columns: 1fr;
        }

        .nav {
          display: none;
        }

        .support-box {
          justify-content: center;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="{{ .Site.BaseURL }}">{{ .Site.Title }}</a>
        <nav class="nav" aria-label="Main navigation">
          <a href="#reviews">Reviews</a>
          <a href="#support">Support</a>
        </nav>
      </div>
    </header>

    <main class="wr-page">
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Curated recommendations</p>
            <h1>Worth Running?</h1>
            <p>
              We spotlight projects with substance: thoughtful remakes, restorations,
              and fan-made efforts that deserve real attention instead of hype alone.
            </p>
            <div class="cta-row">
              <a class="button primary" href="#reviews">Browse the archive</a>
              <a class="button secondary" href="#support">Support the site</a>
            </div>
          </div>

          <div class="hero-card" aria-label="Site stats">
            <div class="mini-panel">
              <div>
                <strong>Curated</strong>
                <span>Quality-first picks and longform writes-ups.</span>
              </div>
              <div>
                <strong>Independent</strong>
                <span>Built for people who care about care, craft, and effort.</span>
              </div>
              <div>
                <strong>Ongoing</strong>
                <span>Expand the archive with more reviews over time.</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="reviews" class="reviews">
        <div class="container">
          <div class="section-header">
            <div>
              <p class="eyebrow">Archive</p>
              <h2>Games worth your time</h2>
            </div>

            <label class="search-wrap" for="game-search">
              <span>Search reviews</span>
              <input id="game-search" type="search" placeholder="Search by title or tag..." />
            </label>
          </div>

          <div class="game-grid">
            {{ range $games }}
              <article class="game-card" data-title="{{ .Title | lower }}" data-summary="{{ .Summary | plainify | lower }}">
                <div class="card-top">
                  <span class="tag">{{ with .Params.categories }}{{ index . 0 }}{{ else }}Review{{ end }}</span>
                  <button class="favorite-btn" type="button" data-slug="{{ .Slug }}" aria-label="Save {{ .Title }} to favorites">☆</button>
                </div>

                <h3>{{ .Title }}</h3>
                <p>{{ .Summary }}</p>

                <div class="meta">
                  {{ with .Params.tags }}
                    {{ range first 3 . }}
                      <span>{{ . }}</span>
                    {{ end }}
                  {{ end }}
                </div>

                <a class="read-more" href="{{ .RelPermalink }}">Read review →</a>
              </article>
            {{ end }}
          </div>
        </div>
      </section>

      <section id="support" class="support">
        <div class="container support-box">
          <div>
            <p class="eyebrow">Support</p>
            <h2>Keep the site independent.</h2>
            <p>If this work is useful to you, consider helping keep it running.</p>
          </div>

          <a class="button primary" href="https://ko-fi.com/" target="_blank" rel="noreferrer">Donate</a>
        </div>
      </section>
    </main>

    <script>
      const searchInput = document.getElementById('game-search');
      const cards = Array.from(document.querySelectorAll('.game-card'));

      if (searchInput) {
        searchInput.addEventListener('input', (event) => {
          const query = event.target.value.trim().toLowerCase();

          cards.forEach((card) => {
            const title = (card.dataset.title || '').toLowerCase();
            const summary = (card.dataset.summary || '').toLowerCase();
            const match = !query || title.includes(query) || summary.includes(query);
            card.style.display = match ? 'flex' : 'none';
          });
        });
      }

      const favoritesKey = 'worth-running-favorites';
      const saved = JSON.parse(localStorage.getItem(favoritesKey) || '[]');

      document.querySelectorAll('.favorite-btn').forEach((button) => {
        const slug = button.dataset.slug;
        if (saved.includes(slug)) {
          button.classList.add('is-favorite');
          button.textContent = '★';
        }

        button.addEventListener('click', () => {
          const current = JSON.parse(localStorage.getItem(favoritesKey) || '[]');
          const index = current.indexOf(slug);

          if (index >= 0) {
            current.splice(index, 1);
            button.classList.remove('is-favorite');
            button.textContent = '☆';
          } else {
            current.push(slug);
            button.classList.add('is-favorite');
            button.textContent = '★';
          }

          localStorage.setItem(favoritesKey, JSON.stringify(current));
        });
      });
    </script>
  </body>
</html>
